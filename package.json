{
    "name":  "durable-incident-agent-root",
    "version":  "1.0.0",
    "private":  true,
    "workspaces":  [
                       "agent",
                       "api",
                       "services/checkout",
                       "services/payments",
                       "services/inventory",
                       "contracts"
                   ],
    "scripts":  {
                    "setup":  "npm install",
                    "build":  "npm run build --workspaces --if-present",
                    "test":  "npm run test --workspaces --if-present",
                    "clean":  "rm -rf node_modules agent/node_modules api/node_modules services/*/node_modules"
                }
}
